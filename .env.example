# These are configuration names, not credentials. Set them in the server's environment.
# Generate the service token locally; keep it in a secret store, never in browser code.
Chatbot__ServiceToken=
Chatbot__RouteCatalog=config/routes.example.json
Chatbot__Resolver=rules
Chatbot__RateLimitPerMinute=60
ASPNETCORE_URLS=http://127.0.0.1:8787
# Optional: use an already installed Ollama server. No training is needed.
Ollama__BaseUrl=http://127.0.0.1:11434/
Ollama__Model=qwen2.5:3b
Ollama__TimeoutSeconds=10
